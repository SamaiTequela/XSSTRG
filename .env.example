# Copy this file to ".env" for local development (never commit the real .env).

# --- The adjudicator (required) ---
# Get a key at https://console.anthropic.com  ->  Settings  ->  API Keys
# You must also add prepaid credit under Billing before it will work.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Online two-device rooms (optional) ---
# Only needed for "Two devices" play. In the Vercel dashboard: Storage -> add an
# Upstash for Redis store; Vercel injects these two automatically on deploy.
# For local `vercel dev`, run `vercel env pull` to fetch them into .env.local,
# or paste them here.
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
